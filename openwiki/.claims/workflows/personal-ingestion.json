        {
          "resource": "repo://src/ingestion/ingestion.ts#L130-L190",
          "version": "repo-lines-v1:sha256:c1027c363150ce408375334d2ef34446a82da37f978f86414f0d4d6d9312b134:"
        }
      ]
    },
